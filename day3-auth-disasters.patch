new file mode 100644
index 0000000..81381c5
--- /dev/null
+++ b/backend/src/main/java/com/disasterrelief/backend/common/GlobalExceptionHandler.java
@@ -0,0 +1,109 @@
+package com.disasterrelief.backend.common;
+
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.HttpStatusCode;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+import org.springframework.http.converter.HttpMessageNotReadableException;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.security.core.AuthenticationException;
+import org.springframework.web.bind.MethodArgumentNotValidException;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.RestControllerAdvice;
+import org.springframework.web.context.request.WebRequest;
+import org.springframework.web.servlet.mvc.method.annotation.ResponseEntityExceptionHandler;
+
+/**
+ * One error format for the whole API: RFC 9457 problem JSON {type,title,status,detail,code,errors[]}.
+ * Unexpected exceptions are logged on the server and returned as a generic 500 (no stack traces, SQL or secrets).
+ */
+@RestControllerAdvice
+public class GlobalExceptionHandler extends ResponseEntityExceptionHandler {
+
+    private static final Logger log = LoggerFactory.getLogger(GlobalExceptionHandler.class);
+
+    @ExceptionHandler(ApiException.class)
+    ResponseEntity<Object> handleApi(ApiException ex) {
+        ProblemDetail problem = problem(ex.status(), ex.code(), ex.getMessage());
+        if (!ex.errors().isEmpty()) {
+            problem.setProperty("errors", ex.errors());
+        }
+        return ResponseEntity.status(ex.status()).body(problem);
+    }
+
+    /** Raised by the security layer (missing/invalid token) through the entry point; see RestAuthHandlers. */
+    @ExceptionHandler(AuthenticationException.class)
+    ResponseEntity<Object> handleAuthentication(AuthenticationException ex) {
+        return ResponseEntity.status(HttpStatus.UNAUTHORIZED)
+                .body(problem(HttpStatus.UNAUTHORIZED, "UNAUTHENTICATED", "Authentication is required."));
+    }
+
+    /** Wrong role. Also raised by @PreAuthorize inside controllers, so it must not fall into the generic 500 handler. */
+    @ExceptionHandler(AccessDeniedException.class)
+    ResponseEntity<Object> handleAccessDenied(AccessDeniedException ex) {
+        return ResponseEntity.status(HttpStatus.FORBIDDEN)
+                .body(problem(HttpStatus.FORBIDDEN, "FORBIDDEN", "You do not have permission to perform this action."));
+    }
+
+    @ExceptionHandler(Exception.class)
+    ResponseEntity<Object> handleUnexpected(Exception ex) {
+        log.error("Unhandled exception", ex);
+        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
+                .body(problem(HttpStatus.INTERNAL_SERVER_ERROR, "INTERNAL_ERROR", "An unexpected error occurred."));
+    }
+
+    @Override
+    protected ResponseEntity<Object> handleMethodArgumentNotValid(MethodArgumentNotValidException ex,
+            HttpHeaders headers, HttpStatusCode status, WebRequest request) {
+        List<FieldProblem> errors = ex.getBindingResult().getFieldErrors().stream()
+                .map(fe -> new FieldProblem(fe.getField(), fe.getDefaultMessage()))
+                .toList();
+        ProblemDetail problem = problem(HttpStatus.BAD_REQUEST, "VALIDATION_ERROR", "Request validation failed.");
+        problem.setProperty("errors", errors);
+        return ResponseEntity.badRequest().body(problem);
+    }
+
+    @Override
+    protected ResponseEntity<Object> handleHttpMessageNotReadable(HttpMessageNotReadableException ex,
+            HttpHeaders headers, HttpStatusCode status, WebRequest request) {
+        // Malformed JSON, wrong types, or an unknown enum value. Do not echo parser internals.
+        return ResponseEntity.badRequest().body(problem(HttpStatus.BAD_REQUEST, "VALIDATION_ERROR",
+                "Request body is missing or malformed (check field types and allowed values)."));
+    }
+
+    /** Every other framework error (405, 415, type mismatch, ...) gets the same shape plus a stable code. */
+    @Override
+    protected ResponseEntity<Object> handleExceptionInternal(Exception ex, Object body, HttpHeaders headers,
+            HttpStatusCode statusCode, WebRequest request) {
+        ResponseEntity<Object> response = super.handleExceptionInternal(ex, body, headers, statusCode, request);
+        if (response != null && response.getBody() instanceof ProblemDetail problem
+                && (problem.getProperties() == null || !problem.getProperties().containsKey("code"))) {
+            problem.setProperty("code", defaultCode(statusCode.value()));
+        }
+        return response;
+    }
+
+    private static ProblemDetail problem(HttpStatus status, String code, String detail) {
+        ProblemDetail problem = ProblemDetail.forStatusAndDetail(status, detail);
+        problem.setTitle(status.getReasonPhrase());
+        problem.setProperty("code", code);
+        return problem;
+    }
+
+    static String defaultCode(int status) {
+        return switch (status) {
+            case 400 -> "VALIDATION_ERROR";
+            case 401 -> "UNAUTHENTICATED";
+            case 403 -> "FORBIDDEN";
+            case 404 -> "NOT_FOUND";
+            case 405 -> "METHOD_NOT_ALLOWED";
+            case 415 -> "UNSUPPORTED_MEDIA_TYPE";
+            case 429 -> "TOO_MANY_REQUESTS";
+            default -> status >= 500 ? "INTERNAL_ERROR" : "ERROR";
+        };
+    }
+}
diff --git a/backend/src/main/java/com/disasterrelief/backend/common/PageQuery.java b/backend/src/main/java/com/disasterrelief/backend/common/PageQuery.java
new file mode 100644
index 0000000..a9fa2de
--- /dev/null
+++ b/backend/src/main/java/com/disasterrelief/backend/common/PageQuery.java
@@ -0,0 +1,67 @@
+package com.disasterrelief.backend.common;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Validated paging and sorting from ?page=0&size=20&sort=field,desc.
+ * The sort field is looked up in a whitelist that maps API names to SQL expressions, so user input is never
+ * concatenated into SQL.
+ */
+public record PageQuery(int page, int size, String orderBySql) {
+
+    public static final int DEFAULT_SIZE = 20;
+    public static final int MAX_SIZE = 100;
+
+    /**
+     * @param allowedSorts API field name to SQL expression, e.g. "startedAt" to "started_at"
+     * @param defaultSort  API field name used when {@code sort} is absent
+     * @param defaultDesc  direction used when {@code sort} is absent
+     */
+    public static PageQuery parse(Integer page, Integer size, String sort,
+                                  Map<String, String> allowedSorts, String defaultSort, boolean defaultDesc) {
+        List<FieldProblem> errors = new ArrayList<>();
+        int p = page == null ? 0 : page;
+        int s = size == null ? DEFAULT_SIZE : size;
+        if (p < 0) {
+            errors.add(new FieldProblem("page", "page must be 0 or greater"));
+        }
+        if (s < 1 || s > MAX_SIZE) {
+            errors.add(new FieldProblem("size", "size must be between 1 and " + MAX_SIZE));
+        }
+
+        String field = defaultSort;
+        boolean desc = defaultDesc;
+        if (sort != null && !sort.isBlank()) {
+            String[] parts = sort.split(",", -1);
+            field = parts[0].trim();
+            if (parts.length > 2) {
+                errors.add(new FieldProblem("sort", "use sort=field or sort=field,asc|desc"));
+            } else if (parts.length == 2) {
+                String direction = parts[1].trim().toLowerCase();
+                if (direction.equals("desc")) {
+                    desc = true;
+                } else if (direction.equals("asc")) {
+                    desc = false;
+                } else {
+                    errors.add(new FieldProblem("sort", "direction must be asc or desc"));
+                }
+            } else {
+                desc = false;
+            }
+        }
+        if (!allowedSorts.containsKey(field)) {
+            errors.add(new FieldProblem("sort", "sort field must be one of " + allowedSorts.keySet()));
+        }
+        if (!errors.isEmpty()) {
+            throw ApiException.validation(errors);
+        }
+        String orderBy = allowedSorts.get(field) + (desc ? " DESC" : " ASC") + ", id ASC";
+        return new PageQuery(p, s, orderBy);
+    }
+
+    public long offset() {
+        return (long) page * size;
+    }
+}
