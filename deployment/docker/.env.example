# Copy to .env (git-ignored) and change the password. Run docker compose from this folder.
# Used by docker-compose.yml AND read by the backend (same variable names, one source of truth).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disaster_relief
DB_USER=drrc_user
DB_PASSWORD=change_me_locally

# Backend (export these in the shell/IDE that runs the backend)
SPRING_PROFILES_ACTIVE=dev
# Frontend
DRRC_BACKEND_URL=http://localhost:8080
