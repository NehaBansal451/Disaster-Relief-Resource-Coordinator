# Copy to .env in deployment/docker and replace the example secrets.
# Start from deployment/docker with: docker compose up --build

DB_NAME=disaster_relief
DB_USER=drrc_user
DB_PASSWORD=replace_with_a_strong_database_password
# Host-published database port; containers connect to db:5432.
DB_HOST_PORT=5432

# Application ports (published on localhost only).
BACKEND_PORT=8080
FRONTEND_PORT=8081

# REQUIRED: generate with: openssl rand -base64 48
# Must be at least 32 characters. Never commit the real value.
JWT_SECRET=replace_with_a_long_random_value_of_32_or_more_chars

# Optional report analyzer integration. Leave blank to disable.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_VERSION_HEADER=
AI_VERSION=
