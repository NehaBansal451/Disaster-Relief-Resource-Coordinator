# Build from the repository root:
# docker build -f deployment/docker/Dockerfile.backend .
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace

# Keep database SQL at the location expected by backend/pom.xml.
COPY database/migrations database/migrations
COPY database/seed database/seed

COPY backend/pom.xml backend/pom.xml
COPY backend/.mvn backend/.mvn
COPY backend/mvnw backend/mvnw
RUN chmod +x backend/mvnw && cd backend && ./mvnw -B -DskipTests dependency:go-offline

COPY backend/src backend/src
RUN cd backend && ./mvnw -B -DskipTests package

FROM eclipse-temurin:21-jre-jammy AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app app
WORKDIR /app
COPY --from=build --chown=app:app /workspace/backend/target/backend-0.0.1-SNAPSHOT.jar app.jar
USER app
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \
  CMD curl --fail --silent http://localhost:8080/actuator/health || exit 1
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
